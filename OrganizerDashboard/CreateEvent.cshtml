@model RaceDay.MVC.Models.CreateEventViewModel

@{
    ViewData["Title"] = "Create Event - RaceDay";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="mb-0">
                <i class="bi bi-plus-circle"></i> Create New Event
            </h1>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="CreateEvent" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="EventTitle" class="form-label">Event Title *</label>
                            <input asp-for="EventTitle" class="form-control" placeholder="Enter event title" required />
                            <span asp-validation-for="EventTitle" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EventDescription" class="form-label">Description</label>
                            <textarea asp-for="EventDescription" class="form-control" rows="4" placeholder="Enter event description"></textarea>
                            <span asp-validation-for="EventDescription" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="EventDate" class="form-label">Event Date *</label>
                                    <input asp-for="EventDate" type="datetime-local" class="form-control" required />
                                    <span asp-validation-for="EventDate" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="EventLocation" class="form-label">Location *</label>
                                    <input asp-for="EventLocation" class="form-control" placeholder="Event location" required />
                                    <span asp-validation-for="EventLocation" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                        <div asp-validation-summary="All" class="text-danger"></div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="EventType" class="form-label">Event Type *</label>
                                    <input asp-for="EventType" class="form-control" placeholder="e.g., Running, Cycling" required />
                                    <span asp-validation-for="EventType" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="EventDistance" class="form-label">Distance (km) *</label>
                                    <input asp-for="EventDistance" type="number" step="0.1" class="form-control" placeholder="0.0" required />
                                    <span asp-validation-for="EventDistance" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TrackID" class="form-label">Track *</label>
                            <select asp-for="TrackID" class="form-select" required>
                                <option value="">-- Select a track --</option>
                                @foreach (var track in Model.Tracks)
                                {
                                    <option value="@track.TrackID">@track.TrackName - @track.TrackLocation</option>
                                }
                            </select>
                            <span asp-validation-for="TrackID" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="BannerImage" class="form-label">Event Banner Image</label>
                            <input asp-for="BannerImage" type="file" class="form-control" accept=".jpg,.jpeg,.png,.gif" />
                            <small class="form-text text-muted">
                                Supported formats: JPG, JPEG, PNG, GIF (Max 5 MB)
                            </small>
                            <span asp-validation-for="BannerImage" class="text-danger small"></span>
                        </div>

                        <div id="imagePreview" class="mb-3" style="display: none;">
                            <img id="previewImage" src="" alt="Banner preview" class="img-fluid" style="max-height: 300px;" />
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="ManageEvents" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Create Event
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm bg-light">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-info-circle"></i> Tips</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <strong>Event Title:</strong> Make it descriptive and easy to remember.
                        </li>
                        <li class="mb-2">
                            <strong>Banner Image:</strong> Upload a high-quality image to represent your event.
                        </li>
                        <li class="mb-2">
                            <strong>Track Selection:</strong> Choose the track where the event will be held.
                        </li>
                        <li>
                            <strong>Date & Time:</strong> Ensure the date is in the future.
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.getElementById('BannerImage').addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (event) {
                    document.getElementById('previewImage').src = event.target.result;
                    document.getElementById('imagePreview').style.display = 'block';
                };
                reader.readAsDataURL(file);
            } else {
                document.getElementById('imagePreview').style.display = 'none';
            }
        });
    </script>
}