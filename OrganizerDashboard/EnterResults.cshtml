@model RaceDay.MVC.Models.ResultsEntryViewModel

@{
    ViewData["Title"] = "Enter Results";
}

<div class="container mt-4">
    <h2>Enter Race Results</h2>

    <p class="text-muted">
        Event ID: @Model.EventID
    </p>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    @if (Model.Enrolments == null || !Model.Enrolments.Any())
    {
        <div class="alert alert-info">
            There are no enrolments available for this event.
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            The current controller does not yet include an action for saving
            results. The table below displays the existing result information.
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Enrolment ID</th>
                        <th>Participant Name</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Finish Time</th>
                        <th>Finish Position</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var enrolment in Model.Enrolments)
                    {
                        <tr>
                            <td>@enrolment.EnrolmentID</td>
                            <td>@enrolment.ParticipantName</td>
                            <td>@enrolment.Category</td>
                            <td>@enrolment.Status</td>
                            <td>
                                @(enrolment.FinishTime?.ToString(@"hh\:mm\:ss") ?? "Not recorded")
                            </td>
                            <td>
                                @(enrolment.FinishPosition?.ToString() ?? "Not recorded")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="OrganizerDashboard"
       asp-action="ManageEvents"
       class="btn btn-secondary mt-3">
        Back to Manage Events
    </a>
</div>