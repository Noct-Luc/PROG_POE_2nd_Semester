@model RaceDay.MVC.Models.EnrolmentsViewModel

@{
    ViewData["Title"] = "Event Enrolments";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2>Event Enrolments</h2>

        @if (Model.Event != null)
        {
            <h5 class="text-muted">@Model.Event.EventTitle</h5>
            <p>Event ID: @Model.Event.EventID</p>
        }
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    @if (Model.Enrolments == null || !Model.Enrolments.Any())
    {
        <div class="alert alert-info">
            No participants are currently enrolled in this event.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Enrolment ID</th>
                        <th>Participant ID</th>
                        <th>Participant Name</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Finish Time</th>
                        <th>Finish Position</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var enrolment in Model.Enrolments)
                    {
                        <tr>
                            <td>@enrolment.EnrolmentID</td>
                            <td>@enrolment.ParticipantID</td>
                            <td>@enrolment.ParticipantName</td>
                            <td>@enrolment.Category</td>
                            <td>@enrolment.Status</td>
                            <td>
                                @(enrolment.FinishTime?.ToString(@"hh\:mm\:ss") ?? "Not recorded")
                            </td>
                            <td>
                                @(enrolment.FinishPosition?.ToString() ?? "Not recorded")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="mt-3">
        <a asp-controller="OrganizerDashboard"
           asp-action="ManageEvents"
           class="btn btn-secondary">
            Back to Manage Events
        </a>

        @if (Model.Event != null)
        {
            <a asp-controller="OrganizerDashboard"
               asp-action="EnterResults"
               asp-route-eventId="@Model.Event.EventID"
               class="btn btn-success">
                Enter Results
            </a>
        }
    </div>
</div>