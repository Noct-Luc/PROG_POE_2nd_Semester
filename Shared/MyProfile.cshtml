@model RaceDay.MVC.Models.UserProfileDto

@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">
    <h2>My Profile</h2>

    <p class="text-muted">
        View and update your account information.
    </p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    @if (Model == null)
    {
        <div class="alert alert-warning">
            Your profile information could not be loaded.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-controller="ParticipantDashboard"
                      asp-action="UpdateProfile"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="UserID" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label">
                            Username
                        </label>

                        <input asp-for="Username"
                               class="form-control" />

                        <span asp-validation-for="Username"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="UserEmail" class="form-label">
                            Email Address
                        </label>

                        <input asp-for="UserEmail"
                               type="email"
                               class="form-control" />

                        <span asp-validation-for="UserEmail"
                              class="text-danger">
                        </span>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        Update Profile
                    </button>
                </form>
            </div>
        </div>
    }

    <a asp-controller="ParticipantDashboard"
       asp-action="Index"
       class="btn btn-secondary mt-3">
        Back to Dashboard
    </a>
</div>