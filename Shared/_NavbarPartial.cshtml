@using System.Security.Claims

@{
    var userRole = User.FindFirst("UserRole")?.Value ?? "Unknown";
    var userName = User.FindFirst(ClaimTypes.Name)?.Value ?? "User";
}

<!-- Role-Based Navigation -->
@if (userRole == "Manager")
{
    <li class="nav-item">
        <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "OrganizerDashboard" ? "active" : "")" 
           asp-controller="OrganizerDashboard" asp-action="Index">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "OrganizerDashboard" && ViewContext.RouteData.Values["Action"]?.ToString() == "ManageEvents" ? "active" : "")" 
           asp-controller="OrganizerDashboard" asp-action="ManageEvents">
            <i class="bi bi-calendar-event"></i> My Events
        </a>
    </li>
}
else if (userRole == "Participant")
{
    <li class="nav-item">
        <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "ParticipantDashboard" ? "active" : "")" 
           asp-controller="ParticipantDashboard" asp-action="Index">
            <i class="bi bi-speedometer2"></i> Dashboard
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "ParticipantDashboard" && ViewContext.RouteData.Values["Action"]?.ToString() == "BrowseEvents" ? "active" : "")" 
           asp-controller="ParticipantDashboard" asp-action="BrowseEvents">
            <i class="bi bi-search"></i> Browse Events
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "ParticipantDashboard" && ViewContext.RouteData.Values["Action"]?.ToString() == "MyEnrolments" ? "active" : "")" 
           asp-controller="ParticipantDashboard" asp-action="MyEnrolments">
            <i class="bi bi-bookmark-check"></i> My Enrolments
        </a>
    </li>
}

<!-- User Menu (Dropdown) -->
<li class="nav-item dropdown">
    <a class="nav-link dropdown-toggle" href="#" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="bi bi-person-circle"></i> @userName
    </a>
    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenu">
        <li>
            <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                <i class="bi bi-person"></i> My Profile
            </a>
        </li>
        <li>
            <a class="dropdown-item" asp-controller="Account" asp-action="Settings">
                <i class="bi bi-gear"></i> Settings
            </a>
        </li>
        <li><hr class="dropdown-divider"></li>
        <li>
            <form method="post" asp-controller="Account" asp-action="Logout" class="mb-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="dropdown-item" style="cursor: pointer; border: none; background: none; padding-left: 1rem; width: 100%; text-align: left;">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </button>
            </form>
        </li>
    </ul>
</li>