@model List<RaceDay.MVC.Models.ParticipantResultDto>

@{
    ViewData["Title"] = "My Results";
}

<div class="container mt-4">
    <h2>My Race Results</h2>

    <p class="text-muted">
        View your previous race performances and finishing positions.
    </p>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You do not have any race results recorded yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Result ID</th>
                        <th>Event Name</th>
                        <th>Event Date</th>
                        <th>Category</th>
                        <th>Finish Time</th>
                        <th>Finish Position</th>
                        <th>Total Finishers</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var result in Model)
                    {
                        <tr>
                            <td>@result.ResultID</td>
                            <td>@result.EventName</td>
                            <td>@result.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@result.Category</td>
                            <td>@result.FinishTime</td>
                            <td>@result.FinishPosition</td>
                            <td>@result.TotalFinishers</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="ParticipantDashboard"
       asp-action="Index"
       class="btn btn-secondary mt-3">
        Back to Dashboard
    </a>
</div>