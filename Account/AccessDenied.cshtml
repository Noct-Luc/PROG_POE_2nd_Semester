@{
    ViewData["Title"] = "Access Denied - RaceDay";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger shadow-lg">
                <div class="card-body p-5 text-center">
                    <i class="bi bi-exclamation-triangle text-danger" style="font-size: 4rem; margin-bottom: 1rem; display: block;"></i>
                    <h1 class="card-title text-danger mb-3">Access Denied</h1>
                    <p class="card-text mb-4">
                        You do not have permission to access this resource.
                    </p>
                    <p class="card-text text-muted mb-4">
                        If you believe you should have access, please contact the administrator.
                    </p>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg">
                        <i class="bi bi-house"></i> Return to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>